# Maintainer: Blackilykat <contact@blackilykat.dev>
pkgname=immich-desktop-sync-git
pkgver=r6.da0417b
pkgrel=1
pkgdesc="Daemon that watches directories on your system and uploads new files to Immich."
arch=('x86_64') # probably works about everywhere but only tested this
url="https://github.com/Blackilykat/immich-desktop-sync"
license=('GPL-3.0')
depends=('curl')
optdepends=('systemd: to be ran as a service') # It will create a service file, but it does not require systemd to run
makedepends=('git' 'gcc' 'make' 'curl')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=('git+https://github.com/Blackilykat/immich-desktop-sync')
sha256sums=('SKIP')
install="${pkgname}.install"

pkgver() {
	cd "$srcdir/${pkgname%-git}"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "$srcdir/${pkgname%-git}"
	make release
}

package() {
	cd "$srcdir/${pkgname%-git}"
	mkdir -p "$pkgdir/usr/bin/"
	cp build/immich-desktop-sync "$pkgdir/usr/bin/"
	mkdir -p "$pkgdir/usr/lib/systemd/user/"
	cp immich-desktop-sync.service "$pkgdir/usr/lib/systemd/user/"
}
